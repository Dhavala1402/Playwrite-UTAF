# Environment Configuration for IGS Playwright Framework
# Copy this file to .env and update with your actual values

# Base URLs
BASE_URL=https://playwright.dev
API_BASE_URL=https://api.github.com

# Test Environment
TEST_ENV=development
CI=false

# Browser Configuration
HEADLESS=true
BROWSER_CHANNEL=chrome

# Timeouts (in milliseconds)
GLOBAL_TIMEOUT=30000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# Test Data
TEST_DATA_PATH=./test-data
SCREENSHOTS_PATH=./screenshots
VIDEOS_PATH=./videos

# Reporting
ALLURE_RESULTS_DIR=./allure-results
PLAYWRIGHT_REPORT_DIR=./playwright-report

# Database (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password

# API Testing
# API_KEY=your_api_key_here
# AUTH_TOKEN=your_auth_token_here

# Mobile Testing
# DEVICE_NAME=iPhone 12
# PLATFORM_VERSION=14.4

# Docker
START_LOCAL_SERVER=false

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/test.log

# Parallel Execution
MAX_WORKERS=4
RETRY_COUNT=2

# Performance Testing
PERFORMANCE_THRESHOLD=5000

# Visual Testing
VISUAL_THRESHOLD=0.2

# Enhanced Logging Configuration
ENABLE_CONSOLE_LOGGING=true
ENABLE_FILE_LOGGING=true
LOG_ROTATION=true
MAX_LOG_SIZE=10MB

# Screenshot and Video Configuration
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true
FULL_PAGE_SCREENSHOTS=false

# API Testing Enhanced Configuration
API_TIMEOUT=30000
API_RETRY_COUNT=3
API_RATE_LIMIT_DELAY=1000

# Authentication Configuration
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=password123
JWT_SECRET=your-jwt-secret-key
SESSION_TIMEOUT=3600

# Performance Monitoring
PERFORMANCE_MONITORING=true
COLLECT_METRICS=true
MEMORY_THRESHOLD_MB=512

# Network Simulation
NETWORK_SIMULATION=false
NETWORK_PRESET=fast3g
OFFLINE_TESTING=false

# Security Configuration
ENABLE_HTTPS=true
IGNORE_HTTPS_ERRORS=false
BYPASS_CSP=false
STRICT_SSL=true

# Debug Configuration
DEBUG_MODE=false
STEP_BY_STEP=false
PAUSE_ON_FAILURE=false
VERBOSE_LOGGING=false

# Test Data Management
ENABLE_TEST_DATA_CLEANUP=true
BACKUP_TEST_DATA=true
DYNAMIC_DATA_GENERATION=true

# Browser Context Configuration
CLEAR_COOKIES=true
CLEAR_LOCAL_STORAGE=true
CLEAR_SESSION_STORAGE=true
ENABLE_JAVASCRIPT=true

# Report Configuration
GENERATE_HTML_REPORT=true
GENERATE_ALLURE_REPORT=false
OPEN_REPORT_AFTER_TEST=false
REPORT_TITLE="IGS Playwright Test Results"

# Mobile Testing Enhanced
MOBILE_VIEWPORT_WIDTH=375
MOBILE_VIEWPORT_HEIGHT=812
DEVICE_SCALE_FACTOR=2
TOUCH_ENABLED=true

# Cross-Browser Testing
TEST_CHROME=true
TEST_FIREFOX=true
TEST_SAFARI=false
TEST_EDGE=false

# Environment Validation
VALIDATE_ENV_ON_START=true
REQUIRED_ENV_VARS=BASE_URL,API_BASE_URL
