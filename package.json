{
  "name": "igs-playwright-framework",
  "version": "1.0.0",
  "description": "IGS Playwright Framework for cross-platform automation testing including web, mobile, and API testing capabilities",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:smoke": "playwright test tests/smoke/ --workers=1",
    "test:demo": "playwright test tests/demo/ --workers=1",
    "test:web-demo": "playwright test tests/demo/web-demo.spec.ts --workers=1",
    "test:api-demo": "playwright test tests/demo/api-demo.spec.ts --workers=1",
    "test:mobile-demo": "playwright test tests/demo/mobile-demo.spec.ts --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:serial": "playwright test --workers=1",
    "test:regression": "playwright test --grep=\"@regression\"",
    "test:e2e": "playwright test --grep=\"@e2e\"",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps",
    "report": "playwright show-report",
    "report:open": "playwright show-report --port=9323",
    "clean": "rimraf test-results/ playwright-report/ allure-results/ allure-report/ logs/ screenshots/ videos/",
    "clean:reports": "rimraf test-results/ playwright-report/",
    "clean:allure": "rimraf allure-results/ allure-report/",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "lint:check": "eslint src/ tests/ --ext .ts --max-warnings 0",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "setup": "npm run clean && npm run install:browsers && npm run type-check",
    "pretest": "npm run type-check",
    "posttest": "npm run clean:reports",
    "env:check": "node -e \"console.log('Environment check passed')\"",
    "deps:check": "npm audit --audit-level moderate",
    "deps:update": "npm update"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "api",
    "mobile"
  ],
  "author": "IGS Team",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "ajv": "^8.17.1",
    "allure-playwright": "^3.3.2",
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.32.0",
    "moment": "^2.30.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "winston": "^3.13.0",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}